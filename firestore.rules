    function countGraphemes(body) {
      let symbols = classifyGraphemeSymbols(body);
      let graphemeMarkers = symbols.replace('(?:[\\x{E000}][\\x{E009}]|[\\x{E000}-\\x{E001}\\x{E009}]|[\\x{E00C}]*(?:(?:[\\x{E008}]*(?:[\\x{E010}]+|[\\x{E00A}][\\x{E010}]*|[\\x{E00B}])[\\x{E00F}]*|[\\x{E008}]+|[\\x{E00F}]+)|[\\x{E00D}]{2}|[\\x{E005}](?:[\\x{E002}-\\x{E004}]*[\\x{E007}][\\x{E005}])*|[\\x{E006}](?:[\\x{E003}-\\x{E004}\\x{E007}]*[\\x{E004}][\\x{E003}-\\x{E004}\\x{E007}]*[\\x{E006}])+|[^\\x{E000}-\\x{E001}\\x{E009}])[\\x{E002}-\\x{E004}\\x{E007}\\x{E00E}]*)', 'x');
      return graphemeMarkers.size();
    }
    // END GENERATED UNICODE 16 GRAPHEME FUNCTIONS

    // Dart String.trim이 지우는 Unicode White_Space와 BOM 집합이다.
    function isBlankPostBody(body) {
      return body.matches('[\\x{9}-\\x{D}\\x{20}\\x{85}\\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]*');
    }

    function isWithinPostBodyLimit(body) {
      let maxGraphemes = 300;
      // 문자열 길이가 제한 이하면 글자 묶음 수도 제한 이하다.
      return body.size() <= maxGraphemes || countGraphemes(body) <= maxGraphemes;
    }

    function validPostBody(body) {
      return body is string && !isBlankPostBody(body) && isWithinPostBodyLimit(body);
    }

    function hasValidPostAuthorFields(data) {
      return data.authorId == request.auth.uid
        && data.nickName is string
        && data.colorIndex is int
        && data.colorIndex >= 0
        && data.colorIndex <= 7;
    }

    function hasInitialPostCounters(data) {
      return data.likeCount is int && data.likeCount == 0
        && data.commentCount is int && data.commentCount == 0;
    }

    function matchesAuthorProfile(data) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return profile != null
        && data.nickName == profile.data.nickName
        && data.colorIndex == profile.data.colorIndex;
    }

    function hasExactly(data, fields) {
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }

    function validTag(tag) {
      return tag is string && (tag.matches('[가-힣ㄱ-ㅎㅏ-ㅣa-zA-Z0-9_]{1,20}')
        || tag in ['운동·건강', '연애·가족', '일·알바']);
    }

    function validPostTags(tags) {
      return tags is list && tags.size() <= 5
        && (tags.size() == 0 || (
          validTag(tags[0])
          && (tags.size() < 2 || validTag(tags[1]))
          && (tags.size() < 3 || validTag(tags[2]))
          && (tags.size() < 4 || validTag(tags[3]))
          && (tags.size() < 5 || validTag(tags[4]))
          && tags.join(',').lower().split(',').toSet().size() == tags.size()
        ));
    }

    function validNewPost(data) {
      let fields = ['authorId', 'nickName', 'colorIndex', 'body', 'createdAt', 'likeCount', 'commentCount'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields.concat(['tags']))
        && validPostTags(data.get('tags', []))
        && hasValidPostAuthorFields(data)
        && data.createdAt is timestamp && data.createdAt == request.time
        && hasInitialPostCounters(data)
        && validPostBody(data.body)
        && matchesAuthorProfile(data);
    }

    match /posts/{postId} {
      allow get, list: if request.auth != null;
      allow create: if request.auth != null && validNewPost(request.resource.data);
      allow update, delete: if false;

      match /comments/{commentId} {
        allow get, list: if request.auth != null
          && exists(/databases/$(database)/documents/posts/$(postId));
        allow write: if false;
      }
    }

    // #12 본인 프로필을 조회하고 최초 1회 생성한다.
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && hasExactly(request.resource.data, ['nickName', 'colorIndex', 'createdAt'])
        && request.resource.data.nickName is string
        && request.resource.data.nickName.size() > 0
        && request.resource.data.nickName.size() <= 40
        && request.resource.data.nickName.matches('[가-힣]+ [가-힣]+')
        && request.resource.data.colorIndex is int
        && request.resource.data.colorIndex >= 0
        && request.resource.data.colorIndex <= 7
        && request.resource.data.createdAt == request.time;
      allow list, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
