# 이 파일을 루트 .env로 복사하고 팀 Firebase 프로젝트의 실제 값을 입력합니다.
# 아래 client는 Android 패키지명이 com.minifeed인 항목입니다.
# 필수: Firebase API 키 — client.api_key[].current_key
FIREBASE_API_KEY=
# 필수: Firebase Android 앱 ID — client.client_info.mobilesdk_app_id
FIREBASE_APP_ID=
# 필수: 메시징 발신자 ID(프로젝트 번호) — project_info.project_number
FIREBASE_MESSAGING_SENDER_ID=
# 필수: Firebase 프로젝트 ID — project_info.project_id
FIREBASE_PROJECT_ID=
# 선택: Storage 버킷 이름 — project_info.storage_bucket, 없으면 빈 값 유지
FIREBASE_STORAGE_BUCKET=
